<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusGuard" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:colorBackground">@color/bg_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.FocusGuard.BottomSheet" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/Animation.FocusGuard.BottomSheet</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.68</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Animation.FocusGuard.BottomSheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
